<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permission to access the internet for AdMob and the contact form -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".MyApplication"
        android:allowBackup="false"
        android:icon="@drawable/txtify"
        android:label="@string/app_name"
        android:roundIcon="@drawable/txtify"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">

        <!-- AdMob App ID Configuration (required in Manifest by Mobile Ads SDK) -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-2223803405403727~8067739426" />

        <!-- Main Activity Declaration -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">

            <!-- Makes the app show up in the launcher -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Allows the app to be an option when tapping "Open with" on a file -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Help Activity Declaration -->
        <activity
            android:name=".HelpActivity"
            android:exported="false"
            android:label="@string/help_title"
            android:parentActivityName=".MainActivity" />

        <!-- Zip Contents Activity Declaration -->
        <activity
            android:name=".ZipContentsActivity"
            android:exported="false"
            android:label="ZIP Contents"
            android:parentActivityName=".MainActivity" />

        <!-- Contact Activity Declaration -->
        <activity
            android:name=".ContactActivity"
            android:exported="false"
            android:label="@string/contact_title"
            android:parentActivityName=".HelpActivity" />

    </application>
</manifest>